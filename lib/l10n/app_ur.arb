  "eventEidAlAdhaArabic": "لَن يَنَالَ اللَّهَ لُحُومُهَا وَلَا دِمَاؤُهَا وَلَٰكِن يَنَالُهُ التَّقْوَىٰ مِنكُمْ",
  "eventEidAlAdhaTranslation": "اللہ کو نہ ان کا گوشت پہنچتا ہے اور نہ ان کا خون، لیکن اسے تمہاری تقویٰ پہنچتی ہے۔",
  "eventEidAlAdhaSource": "قرآن ٢٢:٣٧",
  "eventDayOfArafahArabic": "صِيَامُ يَوْمِ عَرَفَةَ أَحْتَسِبُ عَلَى اللَّهِ أَن يُكَفِّرَ السَّنَةَ الَّتِي قَبْلَهُ وَالسَّنَةَ الَّتِي بَعْدَهُ",
  "eventDayOfArafahTranslation": "یومِ عرفہ کا روزہ، میں اللہ سے امید رکھتا ہوں کہ یہ پچھلے اور اگلے سال کے گناہوں کا کفارہ بنے گا۔",
  "eventDayOfArafahSource": "صحیح مسلم",
  "eventFirstTenDhulHijjahArabic": "مَا مِنْ أَيَّامٍ الْعَمَلُ الصَّالِحُ فِيهِنَّ أَحَبُّ إِلَى اللَّهِ مِنْ هَذِهِ الأَيَّامِ",
  "eventFirstTenDhulHijjahTranslation": "کوئی دن ایسے نہیں جن میں نیک عمل اللہ کو ان دنوں سے زیادہ محبوب ہو۔",
  "eventFirstTenDhulHijjahSource": "صحیح البخاری",
  "eventAshuraArabic": "صِيَامُ يَوْمِ عَاشُورَاءَ أَحْتَسِبُ عَلَى اللَّهِ أَن يُكَفِّرَ السَّنَةَ الَّتِي قَبْلَهُ",
  "eventAshuraTranslation": "یومِ عاشوراء کا روزہ، میں اللہ سے امید رکھتا ہوں کہ یہ پچھلے سال کے گناہوں کا کفارہ بنے گا۔",
  "eventAshuraSource": "صحیح مسلم",
  "eventDaysTashreeqArabic": "وَاذْكُرُوا اللَّهَ فِي أَيَّامٍ مَّعْدُودَاتٍ",
  "eventDaysTashreeqTranslation": "اور گنتی کے دنوں میں اللہ کو یاد کرو۔",
  "eventDaysTashreeqSource": "قرآن ٢:٢٠٣",
  "eventRamadanGuidance": "فجر سے غروب آفتاب تک روزہ رکھیں، رات کو تراویح پڑھیں، قرآن کی کثرت سے تلاوت کریں، صدقہ دیں، دعاؤں اور استغفار میں اضافہ کریں۔",
  "eventLastTenRamadanGuidance": "لیلۃ القدر کو خاص طور پر طاق راتوں میں تلاش کریں۔ رات کی نمازوں میں اضافہ کریں اور ہو سکے تو اعتکاف کریں۔ کثرت سے پڑھیں: اللهم إنك عفوٌّ تحب العفو فاعفُ عنّي۔",
  "eventEidAlFitrGuidance": "نماز عید سے پہلے زکوۃ الفطر ادا کریں، باجماعت نماز عید پڑھیں، تکبیر کہیں، بہترین لباس پہنیں اور خاندان و پڑوسیوں میں خوشی پھیلائیں۔",
  "eventEidAlAdhaGuidance": "نماز عید پڑھیں، نماز کے بعد قربانی کریں اور ہر فرض نماز کے بعد تکبیر کہیں۔ گوشت خاندان، پڑوسیوں اور ضرورت مندوں میں تقسیم کریں۔",
  "eventDayOfArafahGuidance": "اگر حج نہیں کر رہے تو اس مبارک دن کا روزہ رکھیں۔ کثرت سے دعا کریں کیونکہ یہ وہ دن ہے جب اللہ سب سے زیادہ لوگوں کو آگ سے آزاد کرتا ہے۔ ذکر میں اضافہ کریں اور لا إله إلا الله وحده لا شريك له پڑھیں۔",
  "eventFirstTenDhulHijjahGuidance": "پہلے نو دن روزہ رکھیں خاص طور پر یومِ عرفہ کا۔ نیک اعمال میں اضافہ کریں اور ان دنوں میں کثرت سے تکبیر، تہلیل اور تحمید کہیں۔",
  "eventAshuraGuidance": "محرم کی دسویں تاریخ کو روزہ رکھیں اور سنت کی پیروی میں نویں کا بھی اضافہ کریں۔ یاد رکھیں کہ نبی کریم صلی اللہ علیہ وسلم نے یہ روزہ اللہ کا شکر ادا کرنے کے لیے رکھا تھا کہ اللہ نے موسیٰ کو فرعون سے نجات دی۔",
  "eventDaysTashreeqGuidance": "اللہ کا کثرت سے ذکر کریں اور ہر فرض نماز کے بعد تکبیر کہیں۔ یہ کھانے، پینے اور شکر کے دن ہیں۔ ان دنوں میں روزہ جائز نہیں سوائے اس حاجی کے جو قربانی کی استطاعت نہ رکھتا ہو۔",
  "eventWhiteDaysFasting": "ایامِ بیض کے روزوں کی سنت",
