  "eventWhiteDaysFastingArabic": "كَانَ يَأْمُرُنَا أَنْ نَصُومَ الْبِيضَ ثَلَاثَ عَشْرَةَ وَأَرْبَعَ عَشْرَةَ وَخَمْسَ عَشْرَةَ",
  "@eventWhiteDaysFastingArabic": {
    "description": "Arabic hadith text for the White Days fasting reminder"
  },
  "eventWhiteDaysFastingTranslation": "He used to command us to fast the white days: the thirteenth, fourteenth, and fifteenth of the month.",
  "@eventWhiteDaysFastingTranslation": {
    "description": "Translation of the White Days hadith"
  },
  "eventWhiteDaysFastingSource": "Sunan Abi Dawud 2449",
  "@eventWhiteDaysFastingSource": {
    "description": "Source for the White Days hadith"
  },
  "eventWhiteDaysFastingGuidance": "Observe the White Days—the 13th, 14th, and 15th of the Hijri month—in accordance with the Sunnah of the Prophet ﷺ.",
  "@eventWhiteDaysFastingGuidance": {
    "description": "Guidance for the White Days fasting dialog"
  },
  "eventMondayThursdayFastingArabic": "تُعْرَضُ الأَعْمَالُ يَوْمَ الاِثْنَيْنِ وَالْخَمِيسِ فَأُحِبُّ أَنْ يُعْرَضَ عَمَلِي وَأَنَا صَائِمٌ",
  "@eventMondayThursdayFastingArabic": {
    "description": "Arabic hadith text for the Monday and Thursday fasting reminder"
  },
  "eventMondayThursdayFastingTranslation": "Deeds are presented on Monday and Thursday, and I love for my deeds to be presented while I am fasting.",
  "@eventMondayThursdayFastingTranslation": {
    "description": "Translation of the Monday and Thursday fasting hadith"
  },
  "eventMondayThursdayFastingSource": "Jami at-Tirmidhi 747",
  "@eventMondayThursdayFastingSource": {
    "description": "Source for the Monday and Thursday fasting hadith"
  },
  "eventMondayThursdayFastingGuidance": "Fast as many Mondays and Thursdays as you are able, following the Sunnah of the Prophet ﷺ; deeds are presented on these days, and he loved for his deeds to be presented while he was fasting.",
  "@eventMondayThursdayFastingGuidance": {
    "description": "Guidance for the Monday and Thursday fasting dialog"
  },
  "eventWhiteDaysMondayThursdayFastingArabic": "كَانَ يَأْمُرُنَا أَنْ نَصُومَ الْبِيضَ ثَلَاثَ عَشْرَةَ وَأَرْبَعَ عَشْرَةَ وَخَمْسَ عَشْرَةَ · تُعْرَضُ الأَعْمَالُ يَوْمَ الاِثْنَيْنِ وَالْخَمِيسِ",
  "@eventWhiteDaysMondayThursdayFastingArabic": {
