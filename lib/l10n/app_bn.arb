  "eventRamadanArabic": "شَهْرُ رَمَضَانَ الَّذِي أُنزِلَ فِيهِ الْقُرْآنُ هُدًى لِّلنَّاسِ وَبَيِّنَاتٍ مِّنَ الْهُدَىٰ وَالْفُرْقَانِ",
  "eventRamadanTranslation": "রমজান মাস, যে মাসে কুরআন নাযিল করা হয়েছে মানুষের জন্য পথপ্রদর্শক এবং হেদায়াত ও সত্য-মিথ্যার পার্থক্যকারীর সুস্পষ্ট প্রমাণ হিসেবে।",
  "eventRamadanSource": "কুরআন ২:১৮৫",
  "eventLastTenRamadanArabic": "إِنَّا أَنزَلْنَاهُ فِي لَيْلَةِ الْقَدْرِ · وَمَا أَدْرَاكَ مَا لَيْلَةُ الْقَدْرِ · لَيْلَةُ الْقَدْرِ خَيْرٌ مِّنْ أَلْفِ شَهْرٍ",
  "eventLastTenRamadanTranslation": "নিশ্চয়ই আমি এটি কদরের রাতে নাযিল করেছি। আপনি কি জানেন কদরের রাত কী? কদরের রাত হাজার মাসের চেয়ে উত্তম।",
  "eventLastTenRamadanSource": "কুরআন ৯৭:১-৩",
  "eventEidAlFitrArabic": "لِلصَّائِمِ فَرْحَتَانِ: فَرْحَةٌ عِندَ فِطْرِهِ، وَفَرْحَةٌ عِندَ لِقَاءِ رَبِّهِ",
  "eventEidAlFitrTranslation": "রোজাদারের দুটি আনন্দ রয়েছে: একটি ইফতারের সময় এবং একটি তার রবের সাথে সাক্ষাতের সময়।",
  "eventEidAlFitrSource": "বুখারী ও মুসলিম",
  "eventEidAlAdhaArabic": "لَن يَنَالَ اللَّهَ لُحُومُهَا وَلَا دِمَاؤُهَا وَلَٰكِن يَنَالُهُ التَّقْوَىٰ مِنكُمْ",
  "eventEidAlAdhaTranslation": "আল্লাহর কাছে সেগুলোর গোশত ও রক্ত পৌঁছে না, বরং তাঁর কাছে পৌঁছে তোমাদের তাকওয়া।",
  "eventEidAlAdhaSource": "কুরআন ২২:৩৭",
  "eventDayOfArafahArabic": "صِيَامُ يَوْمِ عَرَفَةَ أَحْتَسِبُ عَلَى اللَّهِ أَن يُكَفِّرَ السَّنَةَ الَّتِي قَبْلَهُ وَالسَّنَةَ الَّتِي بَعْدَهُ",
  "eventDayOfArafahTranslation": "আরাফার দিনের রোজা, আমি আল্লাহর কাছে আশা করি যে এটি পূর্ববর্তী ও পরবর্তী বছরের গুনাহ মুছে দেবে।",
  "eventDayOfArafahSource": "সহীহ মুসলিম",
  "eventFirstTenDhulHijjahArabic": "مَا مِنْ أَيَّامٍ الْعَمَلُ الصَّالِحُ فِيهِنَّ أَحَبُّ إِلَى اللَّهِ مِنْ هَذِهِ الأَيَّامِ",
  "eventFirstTenDhulHijjahTranslation": "এমন কোনো দিন নেই যেগুলোতে সৎকর্ম আল্লাহর কাছে এই দিনগুলোর চেয়ে বেশি প্রিয়।",
  "eventFirstTenDhulHijjahSource": "সহীহ আল-বুখারী",
  "eventAshuraArabic": "صِيَامُ يَوْمِ عَاشُورَاءَ أَحْتَسِبُ عَلَى اللَّهِ أَن يُكَفِّرَ السَّنَةَ الَّتِي قَبْلَهُ",
  "eventAshuraTranslation": "আশুরার দিনের রোজা, আমি আল্লাহর কাছে আশা করি যে এটি পূর্ববর্তী বছরের গুনাহ মুছে দেবে।",
  "eventAshuraSource": "সহীহ মুসলিম",
  "eventDaysTashreeqArabic": "وَاذْكُرُوا اللَّهَ فِي أَيَّامٍ مَّعْدُودَاتٍ",
  "eventDaysTashreeqTranslation": "এবং নির্দিষ্ট দিনসমূহে আল্লাহকে স্মরণ করো।",
  "eventDaysTashreeqSource": "কুরআন ২:২০৩",
  "eventRamadanGuidance": "ভোর থেকে সূর্যাস্ত পর্যন্ত রোজা রাখুন, রাতে তারাবীহ নামাজ পড়ুন, প্রচুর কুরআন তিলাওয়াত করুন, দান-সদকা করুন, বেশি বেশি দোয়া ও ইস্তেগফার করুন।",
  "eventLastTenRamadanGuidance": "বিশেষ করে বেজোড় রাতগুলোতে লাইলাতুল কদর সন্ধান করুন। রাতের নামাজ বাড়ান এবং সম্ভব হলে ইতিকাফ করুন। বেশি করে পড়ুন: আল্লাহুম্মা ইন্নাকা আফুউউন তুহিব্বুল আফওয়া ফা'ফু আন্নি।",
  "eventEidAlFitrGuidance": "ঈদের নামাজের আগে ফিতরা আদায় করুন, জামাতে ঈদের নামাজ পড়ুন, তাকবীর বলুন, সবচেয়ে ভালো পোশাক পরুন এবং পরিবার ও প্রতিবেশীদের মধ্যে আনন্দ ছড়িয়ে দিন।",
  "eventEidAlAdhaGuidance": "ঈদের নামাজ পড়ুন, নামাজের পর কুরবানী করুন এবং প্রতিটি ফরজ নামাজের পর তাকবীর বলুন। গোশত পরিবার, প্রতিবেশী ও অভাবীদের মধ্যে বিতরণ করুন।",
  "eventDayOfArafahGuidance": "হজ্জ পালনরত না হলে এই বরকতময় দিনে রোজা রাখুন। প্রচুর দোয়া করুন, কারণ এই দিনে আল্লাহ সবচেয়ে বেশি মানুষকে জাহান্নাম থেকে মুক্তি দেন। যিকির বাড়ান এবং লা ইলাহা ইল্লাল্লাহু ওয়াহদাহু লা শারিকা লাহ পড়ুন।",
  "eventFirstTenDhulHijjahGuidance": "প্রথম নয় দিন রোজা রাখুন, বিশেষ করে আরাফার দিন। সৎকর্ম বাড়ান এবং এই দিনগুলোতে প্রচুর তাকবীর, তাহলীল ও তাহমীদ পড়ুন।",
  "eventAshuraGuidance": "মহররমের ১০ তারিখে রোজা রাখুন এবং সুন্নাহ অনুসরণে ৯ তারিখও যোগ করুন। মনে রাখুন, নবী (সা.) আল্লাহর কৃতজ্ঞতায় এই দিনে রোজা রেখেছিলেন কারণ আল্লাহ মূসাকে ফেরাউন থেকে রক্ষা করেছিলেন।",
  "eventDaysTashreeqGuidance": "আল্লাহকে বেশি করে স্মরণ করুন এবং প্রতিটি ফরজ নামাজের পর তাকবীর বলুন। এগুলো খাওয়া, পানীয় ও কৃতজ্ঞতার দিন। কুরবানী দিতে অক্ষম হাজী ব্যতীত এই দিনগুলোতে রোজা নিষিদ্ধ।",
  "eventWhiteDaysFasting": "আইয়ামে বীযের রোজার সুন্নাহ",
  "eventMondayThursdayFasting": "সোমবার–বৃহস্পতিবার রোজার সুন্নাহ",
  "eventWhiteDaysMondayThursdayFasting": "সোমবার বা বৃহস্পতিবারে আইয়ামে বীয",
  "eventWhiteDaysFastingSubtitle": "প্রতি হিজরি মাসের ১৩, ১৪ ও ১৫ তারিখের রোজা।",
  "eventMondayThursdayFastingSubtitle": "যে দুই দিনে আমল পেশ করা হয়, সে দিনগুলোর নফল রোজা।",
  "eventWhiteDaysMondayThursdayFastingSubtitle": "আইয়ামে বীযের কোনো দিন সোমবার বা বৃহস্পতিবারে পড়েছে।",
  "eventWhiteDaysFastingArabic": "كَانَ يَأْمُرُنَا أَنْ نَصُومَ الْبِيضَ ثَلَاثَ عَشْرَةَ وَأَرْبَعَ عَشْرَةَ وَخَمْسَ عَشْرَةَ",
  "eventWhiteDaysFastingTranslation": "তিনি আমাদের মাসের সাদা দিনগুলো—তেরো, চৌদ্দ ও পনেরো তারিখে—রোজা রাখতে বলতেন।",
  "eventWhiteDaysFastingSource": "সুনান আবু দাউদ ২৪৪৯",
  "eventWhiteDaysFastingGuidance": "নবী ﷺ-এর সুন্নাহ অনুসরণে হিজরি মাসের ১৩, ১৪ ও ১৫ তারিখ—আইয়ামে বীযের রোজা রাখার চেষ্টা করুন।",
