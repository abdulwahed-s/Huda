  "eventRamadanArabic": "شَهْرُ رَمَضَانَ الَّذِي أُنزِلَ فِيهِ الْقُرْآنُ هُدًى لِّلنَّاسِ وَبَيِّنَاتٍ مِّنَ الْهُدَىٰ وَالْفُرْقَانِ",
  "eventRamadanTranslation": "شهر رمضان الذي أُنزل فيه القرآن هدى للناس وبيّنات من الهدى والفرقان",
  "eventRamadanSource": "القرآن ٢:١٨٥",
  "eventLastTenRamadanArabic": "إِنَّا أَنزَلْنَاهُ فِي لَيْلَةِ الْقَدْرِ · وَمَا أَدْرَاكَ مَا لَيْلَةُ الْقَدْرِ · لَيْلَةُ الْقَدْرِ خَيْرٌ مِّنْ أَلْفِ شَهْرٍ",
  "eventLastTenRamadanTranslation": "إنّا أنزلناه في ليلة القدر. وما أدراك ما ليلة القدر. ليلة القدر خير من ألف شهر",
  "eventLastTenRamadanSource": "القرآن ٩٧:١-٣",
  "eventEidAlFitrArabic": "لِلصَّائِمِ فَرْحَتَانِ: فَرْحَةٌ عِندَ فِطْرِهِ، وَفَرْحَةٌ عِندَ لِقَاءِ رَبِّهِ",
  "eventEidAlFitrTranslation": "للصائم فرحتان: فرحة عند فطره، وفرحة عند لقاء ربه",
  "eventEidAlFitrSource": "البخاري ومسلم",
  "eventEidAlAdhaArabic": "لَن يَنَالَ اللَّهَ لُحُومُهَا وَلَا دِمَاؤُهَا وَلَٰكِن يَنَالُهُ التَّقْوَىٰ مِنكُمْ",
  "eventEidAlAdhaTranslation": "لن ينال الله لحومها ولا دماؤها ولكن يناله التقوى منكم",
  "eventEidAlAdhaSource": "القرآن ٢٢:٣٧",
  "eventDayOfArafahArabic": "صِيَامُ يَوْمِ عَرَفَةَ أَحْتَسِبُ عَلَى اللَّهِ أَن يُكَفِّرَ السَّنَةَ الَّتِي قَبْلَهُ وَالسَّنَةَ الَّتِي بَعْدَهُ",
  "eventDayOfArafahTranslation": "صيام يوم عرفة أحتسب على الله أن يكفّر السنة التي قبله والسنة التي بعده",
  "eventDayOfArafahSource": "صحيح مسلم",
  "eventFirstTenDhulHijjahArabic": "مَا مِنْ أَيَّامٍ الْعَمَلُ الصَّالِحُ فِيهِنَّ أَحَبُّ إِلَى اللَّهِ مِنْ هَذِهِ الأَيَّامِ",
  "eventFirstTenDhulHijjahTranslation": "ما من أيام العمل الصالح فيهنّ أحبّ إلى الله من هذه الأيام",
  "eventFirstTenDhulHijjahSource": "صحيح البخاري",
  "eventAshuraArabic": "صِيَامُ يَوْمِ عَاشُورَاءَ أَحْتَسِبُ عَلَى اللَّهِ أَن يُكَفِّرَ السَّنَةَ الَّتِي قَبْلَهُ",
  "eventAshuraTranslation": "صيام يوم عاشوراء أحتسب على الله أن يكفّر السنة التي قبله",
  "eventAshuraSource": "صحيح مسلم",
  "eventDaysTashreeqArabic": "وَاذْكُرُوا اللَّهَ فِي أَيَّامٍ مَّعْدُودَاتٍ",
  "eventDaysTashreeqTranslation": "واذكروا الله في أيام معدودات",
  "eventDaysTashreeqSource": "القرآن ٢:٢٠٣",
  "eventRamadanGuidance": "صوموا من الفجر إلى المغرب، وصلّوا التراويح، وأكثروا من تلاوة القرآن، وتصدّقوا، وأكثروا من الدعاء والاستغفار.",
  "eventLastTenRamadanGuidance": "تحرّوا ليلة القدر في الليالي الوتر. وأكثروا من قيام الليل، واعتكفوا إن استطعتم. وردّدوا: اللهم إنك عفوٌّ تحب العفو فاعفُ عنّي.",
  "eventEidAlFitrGuidance": "أخرجوا زكاة الفطر قبل صلاة العيد، وصلّوا صلاة العيد جماعة، وكبّروا، والبسوا أحسن ثيابكم، وأدخلوا السرور على الأهل والجيران.",
  "eventEidAlAdhaGuidance": "صلّوا صلاة العيد، واذبحوا الأضحية بعدها، وكبّروا دبر كل صلاة مكتوبة، ووزّعوا اللحم على الأهل والجيران والمحتاجين.",
  "eventDayOfArafahGuidance": "صوموا هذا اليوم المبارك إن لم تكونوا حُجّاجاً. وأكثروا من الدعاء، فهو اليوم الذي يُعتق الله فيه أكثر عباده من النار. وأكثروا من الذكر، وقولوا: لا إله إلا الله وحده لا شريك له.",
  "eventFirstTenDhulHijjahGuidance": "صوموا الأيام التسعة الأولى ولا سيما يوم عرفة. وأكثروا من الأعمال الصالحة، وردّدوا التكبير والتهليل والتحميد في هذه الأيام.",
  "eventAshuraGuidance": "صوموا العاشر من محرّم، وأضيفوا إليه التاسع اتباعاً للسنة. وتذكّروا أن النبي صلى الله عليه وسلم صامه شكراً لله على نجاة موسى من فرعون.",
  "eventDaysTashreeqGuidance": "أكثروا من ذكر الله، وكبّروا دبر كل صلاة مكتوبة. فهي أيام أكل وشرب وشكر. ولا يجوز صيامها إلا للحاج الذي لم يجد الهدي.",
  "eventWhiteDaysFasting": "سُنّة صيام الأيام البيض",
  "eventMondayThursdayFasting": "سُنّة صيام الاثنين والخميس",
  "eventWhiteDaysMondayThursdayFasting": "اجتماع سُنّة الأيام البيض مع الاثنين أو الخميس",
  "eventWhiteDaysFastingSubtitle": "صيام الثالث عشر والرابع عشر والخامس عشر من كل شهر هجري.",
  "eventMondayThursdayFastingSubtitle": "صيام نافلة في اليومين اللذين تُعرض فيهما الأعمال.",
  "eventWhiteDaysMondayThursdayFastingSubtitle": "يوم من الأيام البيض يوافق يوم الاثنين أو الخميس.",
  "eventWhiteDaysFastingArabic": "كَانَ يَأْمُرُنَا أَنْ نَصُومَ الْبِيضَ ثَلَاثَ عَشْرَةَ وَأَرْبَعَ عَشْرَةَ وَخَمْسَ عَشْرَةَ",
  "eventWhiteDaysFastingTranslation": "كان يأمرنا بصيام أيام البيض: الثالث عشر والرابع عشر والخامس عشر من الشهر.",
  "eventWhiteDaysFastingSource": "سنن أبي داود 2449",
  "eventWhiteDaysFastingGuidance": "احرصوا على صيام الأيام البيض، وهي الثالث عشر والرابع عشر والخامس عشر من الشهر الهجري، اقتداءً بسنة النبي ﷺ.",
  "eventMondayThursdayFastingArabic": "تُعْرَضُ الأَعْمَالُ يَوْمَ الاِثْنَيْنِ وَالْخَمِيسِ فَأُحِبُّ أَنْ يُعْرَضَ عَمَلِي وَأَنَا صَائِمٌ",
  "eventMondayThursdayFastingTranslation": "تعرض الأعمال يوم الاثنين والخميس، وأحب أن يعرض عملي وأنا صائم.",
  "eventMondayThursdayFastingSource": "جامع الترمذي 747",
  "eventMondayThursdayFastingGuidance": "احرصوا على صيام ما تيسّر من يومَي الاثنين والخميس اقتداءً بسنة النبي ﷺ؛ ففيهما تُعرض الأعمال، وكان يحب أن يُعرض عمله وهو صائم.",
  "eventWhiteDaysMondayThursdayFastingArabic": "كَانَ يَأْمُرُنَا أَنْ نَصُومَ الْبِيضَ ثَلَاثَ عَشْرَةَ وَأَرْبَعَ عَشْرَةَ وَخَمْسَ عَشْرَةَ · تُعْرَضُ الأَعْمَالُ يَوْمَ الاِثْنَيْنِ وَالْخَمِيسِ",
  "eventWhiteDaysMondayThursdayFastingTranslation": "الأيام البيض هي الثالث عشر والرابع عشر والخامس عشر من الشهر الهجري، وتعرض الأعمال يوم الاثنين والخميس.",
  "eventWhiteDaysMondayThursdayFastingSource": "سنن أبي داود 2449 · جامع الترمذي 747",
  "eventWhiteDaysMondayThursdayFastingGuidance": "إذا وافق أحد الأيام البيض يوم الاثنين أو الخميس، فاغتنموا هذا اليوم بصيام النافلة اقتداءً بسنة النبي ﷺ، وأكثروا فيه من الدعاء والذكر.",
