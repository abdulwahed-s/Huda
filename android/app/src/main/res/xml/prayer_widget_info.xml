<?xml version="1.0" encoding="utf-8"?>
<!--
  Provider metadata for the Huda Prayer widget.

  - `targetCellWidth/Height` (Android 12+) set the default placement to
    5×2 cells for stock launchers. Samsung One UI ignores targetCellWidth
    and uses ceil(minWidth / virtualCellDp) for initial placement instead.
    Samsung S20 FE virtual cell = ~92dp, so minWidth=400dp → ceil(400/92)=5
    cells, forcing full-width (column-0) placement. minResizeWidth=36dp is
    the true resize floor so the widget can still shrink to CIRCULAR/SMALL.
    minHeight=180dp → 2-row initial placement on all launchers.
  - `updatePeriodMillis="1800000"` (30 min) provides an Android-native
    safety-net heartbeat. Primary updates still come from exact alarms
    in PrayerWidgetScheduler; this catches cases where the alarm chain
    is silently killed by Doze or OEM battery managers.
  - `configure` is intentionally omitted — the widget pulls all settings
    from the in-app customization screen (PrayerWidgetCustomizationScreen).
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="400dp"
    android:minHeight="100dp"
    android:targetCellWidth="5"
    android:targetCellHeight="2"
    android:minResizeWidth="36dp"
    android:minResizeHeight="36dp"
    android:maxResizeWidth="2048dp"
    android:maxResizeHeight="2048dp"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/prayer_widget_hero_medium"
    android:description="@string/prayer_widget_description"
    android:previewImage="@drawable/prayer_preview"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
