<?xml version="1.0" encoding="utf-8"?>
<!--
  Empty-state layout when the user has not granted location yet. Tapping
  anywhere fires the PendingIntent that deep-links into Huda's Prayer
  Times screen. Mirrors iOS `PrayerWidgetEmptyView` (spec §9): icon +
  centered "set your location" body. The background ImageView matches
  the layout convention of every other prayer widget layout — the
  Updater paints a themed bitmap onto it.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/prayer_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/prayer_widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="14dp">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_widget_location" />

        <TextView
            android:id="@+id/prayer_widget_empty_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Set your location"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="6dp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/prayer_widget_empty_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Open Huda to enable prayer times"
            android:textSize="11sp"
            android:gravity="center"
            android:layout_marginTop="2dp"
            android:maxLines="3"
            android:ellipsize="end" />
    </LinearLayout>
</FrameLayout>
