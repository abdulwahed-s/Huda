<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/prayer_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/prayer_widget_corner_outline"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/prayer_widget_bitmap"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY" />

    <!--
      The Celestial layout is rendered as one stable bitmap, but the countdown
      stays native so Android can advance its seconds without redrawing the
      whole widget. Production code constrains this full-size Chronometer to
      the countdown rectangle by applying family-specific padding.
    -->
    <Chronometer
        android:id="@+id/prayer_widget_live_countdown"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fontFamily="monospace"
        android:gravity="center_vertical|center_horizontal"
        android:includeFontPadding="false"
        android:importantForAccessibility="no"
        android:singleLine="true"
        android:textDirection="ltr"
        android:textStyle="bold"
        android:visibility="gone" />

    <Chronometer
        android:id="@+id/prayer_widget_live_countdown_left"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fontFamily="monospace"
        android:gravity="center_vertical|left"
        android:includeFontPadding="false"
        android:importantForAccessibility="no"
        android:singleLine="true"
        android:textDirection="ltr"
        android:textStyle="bold"
        android:visibility="gone" />

    <Chronometer
        android:id="@+id/prayer_widget_live_countdown_right"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fontFamily="monospace"
        android:gravity="center_vertical|right"
        android:includeFontPadding="false"
        android:importantForAccessibility="no"
        android:singleLine="true"
        android:textDirection="ltr"
        android:textStyle="bold"
        android:visibility="gone" />

</FrameLayout>
