<?xml version="1.0" encoding="utf-8"?>
<!--
  Compact `systemSmall` layout. Spec §7.4:
    VStack(.center, spacing 4), padding (10, top:10, bottom:8):
      • ISO date            11sp .bold serif   primary  monospaced
      • Day-of-week         32sp .bold serif   primary
      • Next prayer name    20sp .bold serif   primary
      • Next prayer time    26sp .bold serif   primary  (h:mm a)
      • Live countdown      18sp .bold serif   primary  (Chronometer)

  All elements horizontally centered. Updater applies tatweel to the
  day-of-week for Arabic/Urdu, and the Amiri optical 1.3× via the
  rendered text size.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/prayer_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/prayer_widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="12dp"
        android:paddingVertical="2dp">

        <TextView
            android:id="@+id/prayer_widget_iso_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFamily="@font/amiri_bold"
            android:gravity="center"
            android:maxLines="1" />

        <TextView
            android:id="@+id/prayer_widget_day_of_week"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="32sp"
            android:textStyle="bold"
            android:fontFamily="@font/amiri_bold"
            android:gravity="center"
            android:maxLines="1"
            android:layout_marginTop="0dp"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/prayer_widget_next_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="@font/amiri_bold"
            android:gravity="center"
            android:maxLines="1"
            android:layout_marginTop="0dp"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/prayer_widget_next_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="26sp"
            android:textStyle="bold"
            android:fontFamily="@font/amiri_bold"
            android:gravity="center"
            android:maxLines="1"
            android:layout_marginTop="0dp"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/prayer_widget_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="@font/amiri_bold"
            android:gravity="center"
            android:maxLines="1"
            android:layout_marginTop="0dp"
            android:includeFontPadding="false" />
    </LinearLayout>
</FrameLayout>
