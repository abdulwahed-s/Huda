<?xml version="1.0" encoding="utf-8"?>
<!--
  API 26+ counterpart of the base bitmap container. Android framework font
  resources are available to the launcher process here, so the live countdown
  can use the bundled Amiri Bold face. API 24–25 keep the base layout's system
  monospace font as the compatibility fallback.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/prayer_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/prayer_widget_corner_outline"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/prayer_widget_bitmap"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY" />

    <Chronometer
        android:id="@+id/prayer_widget_live_countdown"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fontFamily="@font/amiri_bold"
        android:includeFontPadding="false"
        android:importantForAccessibility="no"
        android:singleLine="true"
        android:textDirection="ltr"
        android:textStyle="bold"
        android:visibility="gone" />

</FrameLayout>
