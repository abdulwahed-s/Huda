<?xml version="1.0" encoding="utf-8"?>
<!--
  Transparent rounded-rect used purely as a clip outline for the prayer widget's
  bitmap container. `android:clipToOutline="true"` on the container clips the
  rendered bitmap to these corners at the view level. The radius resolves to the
  Android/OEM system widget radius on API 31+ and to a compatible fallback on
  older launchers, keeping this outline and the Canvas renderer synchronized.
  The transparent fill adds no visible background; it only supplies the outline.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <corners android:radius="@dimen/prayer_widget_outer_corner_radius" />
</shape>
