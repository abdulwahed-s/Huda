default_platform(:ios)

platform :ios do
  private_lane :submit_uploaded_build do |options|
    upload_options = options[:upload_options]
    retries = (ENV["APP_STORE_SUBMIT_RETRIES"] || "6").to_i
    wait_seconds = (ENV["APP_STORE_SUBMIT_RETRY_WAIT_SECONDS"] || "300").to_i

    retries.times do |attempt|
      begin
        UI.message("Submitting iOS build for review (attempt #{attempt + 1}/#{retries})")
        upload_to_app_store(
          upload_options.merge(
            skip_binary_upload: true,
            submit_for_review: true,
            automatic_release: true
          )
        )
        break
      rescue => error
        retryable = error.message.include?("specified pre-release build could not be added") ||
                    error.message.include?("relationship value is not acceptable")

        raise unless retryable && attempt + 1 < retries

        UI.important("App Store Connect is not ready to attach this build yet. Retrying in #{wait_seconds} seconds.")
        sleep(wait_seconds)
      end
    end
  end

  lane :install_profiles do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_KEY_P8"],
      is_key_content_base64: true
    )

    bundle_ids = [
      "com.aw.huda",
      "com.aw.huda.HudaShield",
      "com.aw.huda.HudaShieldAction",
      "com.aw.huda.HudaWidget"
    ]

    mapping = {}
    bundle_ids.each do |app_id|
      get_provisioning_profile(
        api_key: api_key,
        app_identifier: app_id
      )
      mapping[app_id] = lane_context[SharedValues::SIGH_NAME]
    end

    profiles_xml = mapping.map { |k, v| "<key>#{k}</key>\n      <string>#{v}</string>" }.join("\n      ")

    plist_content = <<~PLIST
      <?xml version="1.0" encoding="UTF-8"?>
      <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
      <plist version="1.0">
      <dict>
        <key>method</key>
        <string>app-store-connect</string>
        <key>teamID</key>
        <string>#{ENV['APPLE_TEAM_ID']}</string>
        <key>signingStyle</key>
        <string>manual</string>
        <key>signingCertificate</key>
        <string>Apple Distribution</string>
        <key>uploadSymbols</key>
        <true/>
        <key>provisioningProfiles</key>
        <dict>
          #{profiles_xml}
        </dict>
      </dict>
      </plist>
    PLIST

    File.write("#{ENV['RUNNER_TEMP']}/ExportOptions.plist", plist_content)
    UI.success("ExportOptions.plist written with #{mapping.length} profiles")
    mapping.each { |k, v| UI.message("  #{k} → #{v}") }
  end

  lane :deploy do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_KEY_P8"],
      is_key_content_base64: true
    )

    version = `grep '^version:' ../../pubspec.yaml`.strip.split(' ').last.split('+').first

    ipa_dir = ENV["IPA_DIR"] || "../../build/ios/ipa"
    ipa_path = Dir[File.join(ipa_dir, "*.ipa")].first
    UI.user_error!("No IPA found in #{ipa_dir}") unless ipa_path
    UI.message("Uploading IPA: #{ipa_path}")

    upload_options = {
      api_key: api_key,
      app_version: version,
      skip_screenshots: true,
      force: true,
      precheck_include_in_app_purchases: false,
      submission_information: {
        export_compliance_uses_encryption: false,
        add_id_info_uses_idfa: false
      }
    }

    begin
      upload_to_app_store(
        upload_options.merge(
          ipa: ipa_path,
          submit_for_review: false,
          automatic_release: false
        )
      )
    rescue => error
      already_uploaded = error.message.include?("has already been uploaded") ||
                         error.message.include?("ENTITY_ERROR.ATTRIBUTE.INVALID.DUPLICATE") ||
                         error.message.include?("The bundle version must be higher")

      raise unless already_uploaded

      UI.important("This build already exists in App Store Connect. Continuing to submit the uploaded build.")
    end

    submit_uploaded_build(upload_options: upload_options)
  end
end
