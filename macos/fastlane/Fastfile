default_platform(:mac)

platform :mac do
  # The app and WidgetKit extension have different bundle identifiers and
  # therefore require separate Mac App Store provisioning profiles.
  lane :prepare_signing do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_KEY_P8"],
      is_key_content_base64: true
    )

    get_provisioning_profile(
      api_key: api_key,
      app_identifier: "com.aw.huda",
      platform: "macos",
      force: true
    )
    app_profile = lane_context[SharedValues::SIGH_NAME]

    get_provisioning_profile(
      api_key: api_key,
      app_identifier: "com.aw.huda.HudaMacWidget",
      platform: "macos",
      force: true
    )
    widget_profile = lane_context[SharedValues::SIGH_NAME]

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      targets: ["Runner"],
      build_configurations: ["Release"],
      sdk: "macosx*",
      team_id: ENV["APPLE_TEAM_ID"],
      code_sign_identity: "Apple Distribution",
      profile_name: app_profile
    )

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      targets: ["HudaMacWidgetExtension"],
      build_configurations: ["Release"],
      sdk: "macosx*",
      team_id: ENV["APPLE_TEAM_ID"],
      code_sign_identity: "Apple Distribution",
      profile_name: widget_profile
    )
  end

  lane :deploy do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_KEY_P8"],
      is_key_content_base64: true
    )

    pkg_path = ENV["PKG_PATH"] || "../../build/macos/Huda-macOS.pkg"
    UI.user_error!("No pkg found at #{pkg_path}") unless File.exist?(pkg_path)
    UI.message("Uploading pkg: #{pkg_path}")

    upload_to_app_store(
      api_key: api_key,
      pkg: pkg_path,
      skip_screenshots: true,
      force: true,
      precheck_include_in_app_purchases: false,
      platform: "osx",
      submit_for_review: true,
      automatic_release: true,
      submission_information: {
        export_compliance_uses_encryption: false,
        add_id_info_uses_idfa: false
      }
    )
  end
end
